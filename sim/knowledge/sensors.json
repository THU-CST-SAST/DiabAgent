{
  "_doc": "Glucose sensors = observation channels. modality: cgm (pushed every interval; calibration-required models withhold readings when calibration is overdue), flash (stored internally, revealed by SCAN with 8 h history), meters (on-demand capillary reading via MEASURE_BG). outputs lists the fields a channel can put into an observation.",
  "error_models": {
    "padova_g6": {
      "_doc": "Facchinetti/Vettoretti structure: IG lag (tau), CGM = (a0 + a1*day)*IG + b0 + AR(2) noise. Medians/dispersions from the G6 fit; every dispersion is multiplied by the sensor's spread.",
      "tau_min": {
        "median": 3.78,
        "iqr": [
          2.39,
          5.96
        ]
      },
      "a0": {
        "median": 0.95,
        "sd": 0.126
      },
      "a1_per_day": {
        "median": 0.004,
        "sd": 0.049
      },
      "b0": {
        "median": 6.35,
        "sd": 6.0
      },
      "ar": [
        1.3,
        -0.42
      ],
      "sigma": {
        "median": 3.19,
        "iqr": [
          2.47,
          3.85
        ]
      },
      "bounds": {
        "max_drift_over_wear": 0.15,
        "gain": [
          0.75,
          1.25
        ]
      },
      "evidence": {
        "*": {
          "level": "primary",
          "sources": [
            "vettoretti2019_g6"
          ]
        },
        "bounds": {
          "level": "assumed",
          "sources": [
            "vettoretti2019_g6",
            "fda_icgm_special_controls",
            "shah2018_g6"
          ],
          "note": "Not a published parameter. The G6 model draws its parameters jointly (correlated); sampling a1 alone lets one sensor drift 30-50% over its wear, and the unbounded model gave 95th-percentile |reading/truth-1| of 0.38-0.67 over a full wear (label MARD 8-11%). iCGM special controls require >99% of readings within +-40% and >87% within +-20% of reference across the wear period, and G6 per-day accuracy is roughly flat over days 1-10. Bounds chosen: total drift |a1|*wear_days <= 0.15, effective gain a0+a1*d in [0.75, 1.25]."
        }
      }
    }
  },
  "gaps_default": {
    "start_probability_per_sample": 0.002,
    "mean_length_samples": 3,
    "evidence": {
      "level": "assumed",
      "sources": [],
      "note": "No published per-sample rates found; ~0.6% missing in ~15 min gaps."
    }
  },
